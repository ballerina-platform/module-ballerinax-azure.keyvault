# Details of the organization administrator of the certificate issuer
public type AdministratorDetails record {
    # Phone number
    string phone?;
    # Last name of the administrator.
    @jsondata:Name {value: "last_name"}
    string lastName?;
    # First name
    @jsondata:Name {value: "first_name"}
    string firstName?;
    # Email address
