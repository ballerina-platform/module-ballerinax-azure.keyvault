    string name?;
    # Email address
    string email?;
};

# The issuer for Key Vault certificate
public type IssuerBundle record {
    # The issuer provider
    string provider?;
    # The credentials to be used for the issuer.
    IssuerCredentials credentials?;
    # Details of the organization as provided to the issuer.
    @jsondata:Name {value: "org_details"}
    OrganizationDetails orgDetails?;
    # Attributes of the issuer object.
    IssuerAttributes attributes?;
    # Identifier for the issuer object
    string id?;
};

# Represents the Queries record for the operation: setSasDefinition
public type SetSasDefinitionQueries record {
    # Client API version
    @http:Query {name: "api-version"}
    string apiVersion;
};

# Represents the Queries record for the operation: encrypt
public type EncryptQueries record {
    # Client API version
    @http:Query {name: "api-version"}
    string apiVersion;
};

# Represents the Queries record for the operation: listDeletedSecrets
public type ListDeletedSecretsQueries record {
    # Client API version
    @http:Query {name: "api-version"}
    string apiVersion;
    # Specifies the maximum number of results to return in a page. Setting maxresults to a value less than 1 or greater than 25 results in error response code 400 (Bad Request). If there are additional results to return, then the service returns a nextLink containing a skip token for pagination. In certain cases, the service might return fewer results than specified by maxresults (even 0 results) and also return a nextLink. Clients should not make any assumptions on the minimum number of results per page, and should enumerate all pages until the nextLink becomes null
    @constraint:Int {minValue: 1, maxValue: 25}
    int:Signed32 maxresults?;
};

# The certificate item containing certificate metadata
public type CertificateItem record {
    # Thumbprint of the certificate
    string x5t?;
    # The certificate management attributes.
    CertificateAttributes attributes?;
    # Certificate identifier
    string id?;
    # Application specific metadata in the form of key-value pairs
    record {|string...;|} tags?;
};

# The secret management attributes
public type SecretAttributes record {
    *Attributes;
    # Reflects the deletion recovery level currently in effect for secrets in the current vault. If it contains 'Purgeable', the secret can be permanently deleted by a privileged user; otherwise, only the system can purge the secret, at the end of the retention interval.
    "Purgeable"|"Recoverable+Purgeable"|"Recoverable"|"Recoverable+ProtectedSubscription" recoveryLevel?;
};

# The secret list result
public type SecretListResult record {
    # A response message containing a list of secrets in the key vault along with a link to the next page of secrets
    SecretItem[] value?;
    # The URL to get the next set of secrets
    string nextLink?;
};

# The certificate issuer list result
public type CertificateIssuerListResult record {
    # A response message containing a list of certificate issuers in the key vault along with a link to the next page of certificate issuers
    CertificateIssuerItem[] value?;
    # The URL to get the next set of certificate issuers
    string nextLink?;
};

# Represents the Queries record for the operation: listSecrets
public type ListSecretsQueries record {
    # Client API version
    @http:Query {name: "api-version"}
    string apiVersion;
    # Specifies the maximum number of results to return in a page. Setting maxresults to a value less than 1 or greater than 25 results in error response code 400 (Bad Request). If there are additional results to return, then the service returns a nextLink containing a skip token for pagination. In certain cases, the service might return fewer results than specified by maxresults (even 0 results) and also return a nextLink. Clients should not make any assumptions on the minimum number of results per page, and should enumerate all pages until the nextLink becomes null
    @constraint:Int {minValue: 1, maxValue: 25}
    int:Signed32 maxresults?;
};

